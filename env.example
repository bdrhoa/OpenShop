# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Optional: Kount DDC client ID. Only used on the host in src/config/kount.js.
# VITE_KOUNT_CLIENT_ID=your_kount_client_id
# Kount risk evaluation (same host only). Set these with `wrangler secret put`.
# KOUNT_API_KEY=your_kount_sandbox_api_key
# KOUNT_WEBHOOK_PUBLIC_KEY=your_kount_webhook_public_key
# STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret

# Site Configuration
SITE_URL=https://your-site.pages.dev

# Google OAuth / Picker
GOOGLE_CLIENT_ID=your_oauth_client_id
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_API_KEY=your_browser_api_key