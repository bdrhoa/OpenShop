# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Site Configuration
SITE_URL=https://your-site.pages.dev

# Google OAuth / Picker
GOOGLE_CLIENT_ID=your_oauth_client_id
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_API_KEY=your_browser_api_key
# Kount Payments Fraud (optional; see docs/KOUNT.md). Sandbox endpoints by default.
# Checkouts are held for screening only when client ID, API key and webhook secret are all set.
KOUNT_CLIENT_ID=
KOUNT_API_KEY=
STRIPE_WEBHOOK_SECRET=
KOUNT_MAX_RETRIES=2
KOUNT_FALLBACK_DECISION=APPROVE
KOUNT_CHANNEL=
KOUNT_DDC_ENVIRONMENT=TEST
